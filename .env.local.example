# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Server-side only — bypasses row-level security. Never expose to the client or commit.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Legacy alias — same value as SUPABASE_SECRET_KEY. Some helpers still read this name.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Anon key for Playwright evals (publishable key works here too).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Mapbox — Account > Tokens (public token, starts with pk.)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxx
# Server-only geocoding token (T059 reverse-geocoder). Distinct from the public one above.
MAPBOX_GEOCODING_TOKEN=

# Follow notification email (T018)
# Get from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=
# Sender address. Use onboarding@resend.dev until you verify a domain in Resend.
FOLLOW_EMAIL_FROM=SocialUs <onboarding@resend.dev>
# Shared secret the Vercel cron job sends as Bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=

# Admin allowlist — comma-separated emails that bypass certain UI gates.
ADMIN_EMAILS=

# Local action-layer DB pool — only used when running against local Supabase.
# For prod / staging set via the Supabase project's connection string instead.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth "before-user-created" hook (blocks unwanted signups before the
# auth.users row is written). Create the hook in the Supabase dashboard under
# Authentication > Hooks, point it at
#   https://<your-domain>/api/internal/auth-before-user-created
# then paste the generated secret here verbatim, including the `v1,whsec_` prefix.
# During rotation you may list two secrets separated by `|`.
AUTH_BEFORE_USER_CREATED_HOOK_SECRET=v1,whsec_<base64-secret>
# Optional signup policy. Both are comma-separated and off by default.
# Extra domains to refuse (the built-in disposable-domain list always applies):
SIGNUP_BLOCKED_EMAIL_DOMAINS=
# If non-empty, ONLY these domains may sign up:
SIGNUP_ALLOWED_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# WRITE-BOUND TEST SUITES — tests/media-bucket-storage-api.test.ts
#
# These create real auth users and write real objects, so they refuse to run
# unless you say, explicitly, that the target is a throwaway. Three things must
# all be true; none is inferred from the hostname:
#
#   1. SUPABASE_TEST_EPHEMERAL=1 — you assert this instance is disposable.
#   2. The URL is local (127.0.0.1 / localhost) or Supabase-hosted (a branch).
#   3. Both keys are present.
#
# A branch-shaped hostname alone does NOT enable them: a project URL and a
# branch URL are the same shape, and the cost of guessing wrong is a
# destructive suite running against production data.
#
# A suite that writes over a Postgres connection (tests/migrations-browse-pages)
# is judged on DATABASE_URL, not on SUPABASE_URL — it opens a pg Pool and never
# touches the Supabase API, so that is the instance that matters:
#
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   SUPABASE_TEST_EPHEMERAL=1
#
# Local (run `supabase start` first, then `supabase status -o env` for keys):
#
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_ANON_KEY=<local anon key>
#   SUPABASE_SERVICE_ROLE_KEY=<local service-role key>
#   SUPABASE_TEST_EPHEMERAL=1
#
# A Supabase branch — take all three values from the BRANCH's settings page,
# never the production project's:
#
#   SUPABASE_URL=<the branch's project URL>
#   SUPABASE_ANON_KEY=<the branch's anon key>
#   SUPABASE_SERVICE_ROLE_KEY=<the branch's service-role key>
#   SUPABASE_TEST_EPHEMERAL=1
#
# THE PRODUCTION REFUSAL. Whatever the marker says, the suites refuse to run
# against the project this checkout ships to — NEXT_PUBLIC_SUPABASE_URL above,
# whenever that is a remote host. No variable overrides it. Add any other host
# that must never be written to:
#
#   SUPABASE_PROTECTED_REFS=<comma-separated project refs>
#
# Two cautions. Put these in .env.test.local, which `.env*` already gitignores
# — confirm that before pasting keys, because a service-role key in a public
# repo is a full-database compromise and both repos here are public. And never
# paste production keys into it. The refusal above exists because the mistake
# is easy, not to make it safe to try.

# ---------------------------------------------------------------------------
# .env.test.local — OPTIONAL, and a separate file from this one.
#
# tests/rls-coverage.test.ts is `describe.skipIf(!DATABASE_URL)`: with no
# DATABASE_URL it reports "skipped", which reads as green in a normal run. That
# gate only bites if the variable is present. Create web/.env.test.local with a
# single line to switch it on:
#
#   DATABASE_URL=<connection string>
#
# Local Supabase (run `supabase start` first) — the usual dev target:
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# Or the remote project — safe, the suite only runs one read-only SELECT:
#   copy the DATABASE_URL line out of .env.vercel.local
#
# vitest.config.ts loads this file automatically. It is gitignored by `.env*`.

# ---------------------------------------------------------------------------
# Canonical public origin — used for magic-link/OAuth redirectTo, OG tags, QR
# codes (src/lib/site-url.ts). LEAVE UNSET LOCALLY: with no value, the client
# falls back to window.location.origin so dev links land on localhost:3000.
# Set it in Vercel (Production scope) to the canonical host, and add the same
# origin's /auth/callback to Supabase Auth -> URL Configuration -> Redirect URLs.
#
#   NEXT_PUBLIC_SITE_URL=https://www.socialus.org

# The operator — the one member who may review reports at /admin/reports.
# Their members.id. Server-side only; never NEXT_PUBLIC_.
# UNSET AUTHORISES NOBODY, deliberately: the failure mode of the alternative is
# the moderation surface open to the internet.
# (ADMIN_EMAILS above is vendor-era residue, read by nothing. Do not wire to it.)
OPERATOR_MEMBER_ID=

# #280 — builder accounts. The seed every builder password derives from; keep
# it in a private env file and GitHub secrets only. Never commit a value.
BUILDER_SEED=
# The operator persona's builder member id (from the "Builder accounts" workflow's list).
BUILDER_OPERATOR_MEMBER_ID=

# F078/F080 — a sensitive-content or threat-of-harm report texts the operator.
# Twilio account, sending number and the operator's phone; unset sends nothing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPERATOR_PHONE=

# F100 — the AI first-pass read of reported content (shadow mode). Unset means no read is made.
ANTHROPIC_API_KEY=
